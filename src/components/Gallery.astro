---
import { Picture, getImage } from 'astro:assets';
import SplitHeading from './SplitHeading.astro';
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/config';
import { tours } from '@/data/tours';
import { creditFor } from '@/data/credits';
import { legalUi } from '@/i18n/legal';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);

// Solo imágenes de las fichas. Las que no son fotos acreditadas se marcan como ilustrativas.
const illus = { es: 'Imagen ilustrativa', en: 'Illustrative image', pt: 'Imagem ilustrativa' }[lang];
const shots = [
  ...tours.filter((x) => x.image).map((x, i) => ({
    src: x.image!.src,
    alt: x.image!.alt[lang],
    caption: x.name[lang],
    credit: x.image!.credit ? creditFor(x.image!.credit) : undefined,
    shape: x.slug === 'coco-bongo' ? 'tall' : i % 2 ? 'std' : 'wide',
  })),
];
const items = await Promise.all(
  shots.map(async (s) => ({ ...s, full: (await getImage({ src: s.src, width: Math.min(1600, s.src.width), format: 'webp', quality: 78 })).src })),
);
---

<section class="section gallery" id="galeria" aria-labelledby="gal-title">
  <div class="shell section-head">
    <SplitHeading class="h-lg" id="gal-title" text={d.gallery.title} em={d.gallery.titleEm} />
  </div>
  <ul class="rail" data-gallery data-drag>
    {items.map((it, i) => (
      <li class={`shot is-${it.shape}`}>
        <button type="button" data-shot={i} data-full={it.full} data-alt={it.alt} data-caption={it.credit ? `${it.caption} · ${legalUi[lang].photo}: ${it.credit.author} (${it.credit.license})` : `${it.caption} · ${illus}`} aria-label={`${d.gallery.open}: ${it.caption}`}>
          <Picture src={it.src} alt={it.alt} formats={['webp']} widths={[400, 720, 1080]} sizes="(min-width: 64rem) 45vw, 82vw" loading="lazy" decoding="async" quality={66} />
        </button>
        <p><span class="cap">{it.caption}</span>{it.credit ? <small class="credit">{legalUi[lang].photo}: {it.credit.author} · {it.credit.license}</small> : <small class="credit">{illus}</small>}</p>
      </li>
    ))}
  </ul>

  <dialog class="lightbox" data-lightbox aria-label={d.gallery.dialog}>
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label={d.gallery.close}>✕</button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label={d.gallery.prev}>←</button>
    <figure>
      <img data-lb-img alt="" />
      <figcaption><span data-lb-count></span><span data-lb-caption></span></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label={d.gallery.next}>→</button>
  </dialog>
</section>

<style>
  .gallery { position: relative; padding-block: clamp(5rem, 10vw, 8rem); background: linear-gradient(180deg, var(--ocean-950), #0d1a2b 60%, #1b0c22); color: #f6e9e2; overflow: clip; }
  .gallery :global(.display) { color: #fff3ea; }
  .gallery :global(.display em) { color: #f2a7bf; }
  .section-head { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .rail { display: flex; gap: clamp(1.2rem, 3vw, 2.6rem); overflow-x: auto; scroll-snap-type: x proximity; padding: 2rem max(var(--gutter), calc((100vw - var(--max)) / 2)) 2.5rem; scrollbar-width: none; align-items: center; cursor: grab; }
  .rail.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .rail::-webkit-scrollbar { display: none; }
  /* Postal: marco de papel, leve giro alterno, pie manuscrito. */
  .shot { flex: none; width: min(78vw, 30rem); scroll-snap-align: center; padding: 0.7rem 0.7rem 1rem; background: #fff6ee; color: #2a1233; border-radius: 0.35rem; box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.8); rotate: -1.6deg; transition: rotate 0.7s var(--ease), translate 0.7s var(--ease); }
  .shot:nth-child(even) { rotate: 1.4deg; translate: 0 1.4rem; }
  .shot:nth-child(3n) { width: min(62vw, 24rem); }
  .shot:hover, .shot:focus-within { rotate: 0deg; translate: 0 -0.4rem; }
  .shot button { display: block; width: 100%; overflow: hidden; border-radius: 0.2rem; aspect-ratio: 4 / 3; background: #2a1233; cursor: zoom-in; }
  .shot.is-tall button { aspect-ratio: 3 / 4; }
  .shot :global(picture), .shot :global(img) { display: block; width: 100%; height: 100%; pointer-events: none; }
  .shot :global(img) { object-fit: cover; transition: scale 1.2s var(--ease); }
  .shot button:hover :global(img) { scale: 1.05; }
  .shot p { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.3rem 1rem; margin-top: 0.75rem; }
  .cap { font-family: var(--font-display); font-style: italic; font-size: 1.25rem; }
  .shot .credit { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #8a6a86; }

  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(3 26 36 / 0.96); color: var(--white); overscroll-behavior: contain; }
  .lightbox[open] { display: grid; place-items: center; animation: lb 0.4s var(--ease); }
  .lightbox::backdrop { background: rgb(3 26 36 / 0.9); }
  @keyframes lb { from { opacity: 0; } }
  .lightbox figure { display: grid; gap: 0.75rem; justify-items: center; padding: 4rem 1rem; max-width: 100%; }
  .lightbox img { max-width: 100%; max-height: calc(100dvh - 9rem); width: auto; object-fit: contain; border-radius: var(--radius-sm); }
  .lightbox figcaption { display: flex; gap: 1rem; font-size: 0.9rem; }
  .lightbox figcaption span:first-child { opacity: 0.6; }
  .lb-btn { position: absolute; width: 3rem; height: 3rem; display: grid; place-items: center; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.35); background: rgb(3 26 36 / 0.6); color: var(--white); font-size: 1.1rem; }
  .lb-btn:hover { background: var(--white); color: var(--ocean-950); }
  .lb-close { top: max(1rem, env(safe-area-inset-top)); right: 1rem; }
  .lb-prev { left: 1rem; bottom: 1rem; }
  .lb-next { right: 1rem; bottom: 1rem; }
  @media (min-width: 48rem) { .lb-prev, .lb-next { top: 50%; bottom: auto; transform: translateY(-50%); } }
</style>
