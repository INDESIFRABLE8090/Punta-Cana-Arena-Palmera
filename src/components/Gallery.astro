---
import { Picture, getImage } from 'astro:assets';
import SplitHeading from './SplitHeading.astro';
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/config';
import { tours } from '@/data/tours';
import { creditFor } from '@/data/credits';
import { legalUi } from '@/i18n/legal';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);

// Solo fotografías reales con licencia y resolución suficiente para ocupar la pantalla (auditoría 22 nov 2026).
// Las imágenes sin procedencia o de aspecto generado no se muestran aquí como «postales» del destino.
const keep = ['commons-isla-catalina.jpg', 'commons-isla-saona.jpg', 'commons-mono-ardilla.jpg'];
const shots = keep
  .map((file) => tours.find((x) => x.image?.credit === file))
  .filter((x): x is NonNullable<typeof x> => Boolean(x))
  .map((x) => ({ src: x.image!.src, alt: x.image!.alt[lang], caption: x.name[lang], line: x.tagline[lang], position: x.image!.position ?? '50% 50%', credit: creditFor(x.image!.credit!) }));
const items = await Promise.all(
  shots.map(async (s) => ({ ...s, full: (await getImage({ src: s.src, width: Math.min(2400, s.src.width), format: 'webp', quality: 82 })).src })),
);
---

<section class="section gallery" id="galeria" aria-labelledby="gal-title">
  <div class="shell section-head">
    <SplitHeading class="h-lg" id="gal-title" text={d.gallery.title} em={d.gallery.titleEm} />
  </div>
  <ol class="scenes shell" data-spatial-gallery>
    {items.map((it, i) => (
      <li class="scene" style={`--i:${i}`}>
        <div class="stage">
        <div class="frame">
          <Picture src={it.src} alt={it.alt} formats={['avif', 'webp']} widths={[768, 1080, 1600, 2400]} sizes={i === 0 ? "(min-width: 64rem) 58vw, 92vw" : "(min-width: 64rem) 38vw, (min-width: 361px) 46vw, 92vw"} loading="lazy" decoding="async" quality={80} style={`object-position:${it.position}`} />
        </div>
        <div class="cap shell">
          <p class="n">{String(i + 1).padStart(2, '0')} / {String(items.length).padStart(2, '0')}</p>
          <p class="t">{it.caption}</p>
          <p class="l">{it.line}</p>
          <div class="row">
            <button type="button" class="zoom" data-shot={i} data-full={it.full} data-alt={it.alt} data-caption={`${it.caption} · ${legalUi[lang].photo}: ${it.credit?.author} (${it.credit?.license})`} aria-label={`${d.gallery.open}: ${it.caption}`}>{d.gallery.open}</button>
            <small>{legalUi[lang].photo}: {it.credit?.author} · {it.credit?.license}</small>
          </div>
        </div>
        </div>
      </li>
    ))}
  </ol>

  <dialog class="lightbox" data-lightbox aria-label={d.gallery.dialog}>
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label={d.gallery.close}>✕</button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label={d.gallery.prev}>←</button>
    <figure>
      <img data-lb-img alt="" />
      <figcaption><span data-lb-count></span><span data-lb-caption></span></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label={d.gallery.next}>→</button>
  </dialog>
</section>

<style>
  .gallery { position: relative; padding-top: clamp(5rem, 10vw, 8rem); background: #0d1a2b; color: #f6e9e2; }
  .gallery :global(.display) { color: #fff3ea; }
  .gallery :global(.display em) { color: #f2a7bf; }
  .section-head { margin-bottom: clamp(2rem, 6vw, 4rem); }

  /* Three licensed destination images share a single editorial scene.
     Preserve reading order, native scroll and the accessible lightbox. */
  .gallery { padding-bottom:clamp(4rem,9vw,8rem); overflow:clip; background:radial-gradient(ellipse at 70% 50%,#1d5251 0%,transparent 60%),#0d1a2b; }
  .scenes { display:grid; grid-template-columns:minmax(0,1fr); gap:clamp(.9rem,2vw,1.7rem); list-style:none; }
  .scene { position:relative; min-width:0; isolation:isolate; }
  .stage { position:relative; isolation:isolate; display:flex; flex-direction:column; justify-content:flex-end; min-height:20rem; overflow:hidden; border-radius:clamp(1rem,2vw,2rem); padding:clamp(1rem,3vw,2rem); background:#142d37; box-shadow:0 28px 60px -38px #000; border:1px solid rgb(255 255 255 / .15); }
  .scene:first-child .stage { min-height:clamp(25rem,65vw,41rem); }
  .frame { position:absolute; inset:0; z-index:-2; overflow:hidden; }
  .stage::after { content:""; position:absolute; inset:0; z-index:-1; pointer-events:none; background:linear-gradient(180deg,transparent 10%,rgb(6 16 27 / .24) 32%,rgb(6 16 27 / .92) 80%,#06101b); }
  .frame :global(picture), .frame :global(img) { display:block; width:100%; height:100%; }
  .frame :global(img) { object-fit:cover; }
  .cap { position:relative; display:grid; gap:.4rem; width:100%; max-width:none; margin:0; padding:0; }
  .n { font-size:.72rem; font-weight:750; letter-spacing:.18em; color:#fff3ea; }
  .t { font-family:var(--font-display); font-weight:360; font-variation-settings:'opsz' 144; font-size:clamp(2rem,5vw,4rem); line-height:1; letter-spacing:-.035em; color:#fff3ea; overflow-wrap:anywhere; }
  .scene:first-child .t { font-size:clamp(3rem,9vw,6rem); }
  .l { font-family:var(--font-display); font-style:italic; font-size:clamp(1rem,2vw,1.3rem); color:#fff3ea; }
  .row { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem 1rem; margin-top:.4rem; }
  .zoom { min-height:44px; padding:0 1.1rem; border:1px solid #c8d4d6; border-radius:999px; background:#10242f; color:#fff3ea; font-weight:650; font-size:.86rem; cursor:zoom-in; }
  .zoom:hover { background:#fff3ea; color:#142d37; }
  .row small { font-size:.68rem; line-height:1.5; color:#e1e8e7; }
  @media(min-width:361px) {
    .scenes { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .scene:first-child { grid-column:1/-1; }
    .scene:not(:first-child) .stage { padding:.9rem; }
    .scene:not(:first-child) .t { font-size:clamp(1.5rem,4.5vw,4rem); }
    .scene:not(:first-child) .zoom { padding:0 .65rem; font-size:.78rem; }
    .scene:not(:first-child) .l { font-size:.95rem; }
  }
  @media(min-width:64rem) {
    .scenes { grid-template-columns:minmax(0,1.45fr) minmax(0,1fr); grid-template-rows:repeat(2,minmax(17rem,auto)); }
    .scene:first-child { grid-column:1; grid-row:1/span 2; }
    .stage { height:100%; }
    .scene:first-child .stage { min-height:100%; }
    .scene:nth-child(2) { grid-column:2; grid-row:1; }
    .scene:nth-child(3) { grid-column:2; grid-row:2; }
  }
  @keyframes gallery-drift { from {transform:translateY(-3%) scale(1.1)} to {transform:translateY(3%) scale(1.1)} }
  @media(prefers-reduced-motion:no-preference) {
    @supports(animation-timeline:view()) {
      .frame :global(picture) {animation:gallery-drift linear both;animation-timeline:view();animation-range:entry 0% exit 100%;}
    }
    @media(hover:hover) and (pointer:fine) {
      .frame :global(img) {transition:transform 1s var(--ease)}
      .scene:hover .frame :global(img), .scene:focus-within .frame :global(img) {transform:scale(1.055)}
    }
  }
  @media(prefers-reduced-motion:reduce) {
    .lightbox[open] {animation:none}
  }

  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(3 26 36 / 0.96); color: var(--white); overscroll-behavior: contain; }
  .lightbox[open] { display: grid; place-items: center; animation: lb 0.4s var(--ease); }
  .lightbox::backdrop { background: rgb(3 26 36 / 0.9); }
  @keyframes lb { from { opacity: 0; } }
  .lightbox figure { display: grid; gap: 0.75rem; justify-items: center; padding: 4rem 1rem; max-width: 100%; }
  .lightbox img { max-width: 100%; max-height: calc(100dvh - 9rem); width: auto; object-fit: contain; border-radius: var(--radius-sm); }
  .lightbox figcaption { display: flex; gap: 1rem; font-size: 0.9rem; }
  .lightbox figcaption span:first-child { opacity: 0.6; }
  .lb-btn { position: absolute; width: 3rem; height: 3rem; display: grid; place-items: center; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.35); background: rgb(3 26 36 / 0.6); color: var(--white); font-size: 1.1rem; }
  .lb-btn:hover { background: var(--white); color: var(--ocean-950); }
  .lb-close { top: max(1rem, env(safe-area-inset-top)); right: 1rem; }
  .lb-prev { left: 1rem; bottom: 1rem; }
  .lb-next { right: 1rem; bottom: 1rem; }
  @media (min-width: 48rem) { .lb-prev, .lb-next { top: 50%; bottom: auto; transform: translateY(-50%); } }
</style>
