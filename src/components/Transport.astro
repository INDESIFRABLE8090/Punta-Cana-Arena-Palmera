---
import Icon from './Icon.astro';
import SplitHeading from './SplitHeading.astro';
import Waves from './reactbits/Waves';
import ShinyText from './reactbits/ShinyText';
import Magnet from './reactbits/Magnet';
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/config';
import { waLink } from '@/scripts/whatsapp';
import { fleet } from '@/data/fleet';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---

<section class="section transport" id="transporte" aria-labelledby="tr-title">
  <div class="waves" aria-hidden="true">
    <Waves client:visible lineColor="rgba(227, 200, 143, 0.2)" backgroundColor="transparent" spacing={16} amplitude={20} speed={0.55} mouseRadius={220} clickRipple={false} />
  </div>
  <div class="shell grid">
    <div class="copy">
      <p class="eyebrow"><ShinyText client:visible text={d.transport.eyebrow} color="#e3c88f" shineColor="#ffffff" speed={3} /></p>
      <SplitHeading class="h-lg" id="tr-title" text={d.transport.title} em={d.transport.titleEm} />
      <p class="lead">{d.transport.lead}</p>
      <div class="actions">
        <Magnet client:idle padding={50}>
          <a class="btn btn-wa" href={waLink(d.client.waTransport)} target="_blank" rel="noopener noreferrer" data-wa><Icon name="whatsapp" />{d.transport.cta}</a>
        </Magnet>
        <button type="button" class="btn btn-ghost" data-add-transport aria-pressed="false">
          <span class="i-plus"><Icon name="plus" /></span><span class="i-check"><Icon name="check" /></span>{d.transport.add}
        </button>
      </div>
    </div>
    <ol class="steps">
      {d.transport.steps.map((s, i) => (
        <li>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <div><h3>{s.title}</h3><p>{s.copy}</p></div>
        </li>
      ))}
    </ol>
    {fleet.length > 0 && (
      <ul class="fleet">
        {fleet.map((v) => (
          <li><h3 class="display">{v.name}</h3>{v.details[lang].length > 0 && <ul>{v.details[lang].map((x) => <li>{x}</li>)}</ul>}</li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .transport { background: radial-gradient(120% 90% at 85% 0%, #0d3140 0%, var(--ocean-950) 60%); color: var(--sand-50); overflow: clip; isolation: isolate; }
  .waves { position: absolute; inset: 0; z-index: -1; -webkit-mask-image: linear-gradient(90deg, transparent, #000 55%); mask-image: linear-gradient(90deg, transparent, #000 55%); }
  .eyebrow { color: var(--gold-300); }
  .transport :global(.display em) { color: var(--gold-300); }
  .lead { color: rgb(244 236 220 / 0.8); }
  .grid { display: grid; gap: 3rem; }
  .copy { display: grid; gap: 1.25rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  .actions button .i-check, .actions button[aria-pressed='true'] .i-plus { display: none; }
  .actions button[aria-pressed='true'] .i-check { display: inline-flex; }
  .actions button[aria-pressed='true'] { background: var(--sand-50); color: var(--ocean-950); border-color: transparent; }
  .steps { display: grid; }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; padding-block: 1.5rem; border-top: 1px solid rgb(227 200 143 / 0.28); }
  .steps li:last-child { border-bottom: 1px solid rgb(227 200 143 / 0.28); }
  .n { font-family: var(--font-display); font-weight: 600; font-size: 2rem; line-height: 1; color: var(--gold-300); }
  .steps h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.4rem; margin-bottom: 0.25rem; }
  .steps p { color: rgb(244 236 220 / 0.72); font-size: 0.95rem; }
  .fleet { display: grid; gap: 1rem; grid-column: 1 / -1; }
  .fleet > li { padding: 1.5rem; border: 1px solid rgb(227 200 143 / 0.28); border-radius: var(--radius); }
  @media (min-width: 60rem) {
    .grid { grid-template-columns: 1.1fr 0.9fr; gap: 5rem; align-items: end; }
    .fleet { grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
  }
</style>
