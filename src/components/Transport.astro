---
import Icon from './Icon.astro';
import SplitHeading from './SplitHeading.astro';
import ShinyText from './reactbits/ShinyText';
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/config';
import { waLink } from '@/scripts/whatsapp';
import { fleet } from '@/data/fleet';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ai = { es: 'Escenas ilustrativas creadas con IA · vehículos por confirmar', en: 'Illustrative scenes created with AI · vehicles to be confirmed', pt: 'Cenas ilustrativas criadas com IA · veículos a confirmar' }[lang];
---

<section class="section transport" id="transporte" aria-labelledby="tr-title">
  <div class="bgv" aria-hidden="true">
    <img src={`${base}media/veo/road-1536.webp`} alt="" width="1536" height="864" loading="lazy" decoding="async" />
    <video data-lazy-video data-src-sm={`${base}media/veo/road-720.mp4`} data-src-lg={`${base}media/veo/road-1080.mp4`} muted loop playsinline preload="none"></video>
  </div>
  <p class="ai">{ai}</p>
  <div class="shell grid">
    <div class="copy">
      <p class="eyebrow"><ShinyText client:visible text={d.transport.eyebrow} color="#e3c88f" shineColor="#ffffff" speed={3} /></p>
      <SplitHeading class="h-lg" id="tr-title" text={d.transport.title} em={d.transport.titleEm} />
      <p class="lead">{d.transport.lead}</p>
    </div>
    <form class="ticket" data-ticket novalidate aria-label={d.transport.eyebrow}
      data-msg={d.client.waTransport} data-l-from={d.quick.from} data-l-to={d.quick.to} data-l-date={d.quick.date} data-l-people={d.quick.people}>
      <div class="t-head"><span>Arena y Palma</span><span>{d.transport.eyebrow}</span></div>
      <div class="route">
        <label class="end">
          <span class="lbl">{d.quick.from}</span>
          <b class="code" data-code="from">—</b>
          <input name="from" type="text" maxlength="80" autocomplete="off" placeholder={`${d.quick.fromPh}…`} />
        </label>
        <svg class="arc" viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true">
          <path id="tr-arc" d="M6 50 C 60 -8, 140 -8, 194 50" />
          <circle r="4.5" class="car"><animateMotion dur="3.6s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines="0.45 0 0.55 1"><mpath href="#tr-arc" /></animateMotion></circle>
        </svg>
        <label class="end to">
          <span class="lbl">{d.quick.to}</span>
          <b class="code" data-code="to">—</b>
          <input name="to" type="text" maxlength="80" autocomplete="off" placeholder={`${d.quick.toPh}…`} />
        </label>
      </div>
      <div class="cells">
        <label><span class="lbl">{d.quick.date}</span><input name="date" type="date" /></label>
        <label><span class="lbl">{d.quick.people}</span><input name="people" type="number" inputmode="numeric" min="1" max="60" value="2" /></label>
      </div>
      <div class="perf" aria-hidden="true"></div>
      <div class="t-actions">
        <a class="send" href={waLink(d.client.waTransport)} target="_blank" rel="noopener noreferrer" data-wa data-ticket-send><Icon name="whatsapp" />{d.transport.cta}</a>
        <button type="button" class="add" data-add-transport aria-pressed="false">
          <span class="i-plus"><Icon name="plus" /></span><span class="i-check"><Icon name="check" /></span>{d.transport.add}
        </button>
      </div>
    </form>
    {fleet.length > 0 && (
      <ul class="fleet">
        {fleet.map((v) => (
          <li><h3 class="display">{v.name}</h3>{v.details[lang].length > 0 && <ul>{v.details[lang].map((x) => <li>{x}</li>)}</ul>}</li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .transport { position: relative; background: var(--ocean-950); color: var(--sand-50); overflow: clip; isolation: isolate; }
  .bgv { position: absolute; inset: 0; z-index: -1; }
  .bgv img, .bgv video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 30% 50%; }
  .bgv video { opacity: 0; transition: opacity 1.2s ease; }
  .bgv :global(video.is-on) { opacity: 1; }
  /* Velo: oscuro donde va el texto, deja ver la carretera junto al billete. */
  .bgv::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, var(--ocean-950) 0%, rgb(3 26 36 / 0.82) 18%, rgb(3 26 36 / 0.7) 60%, var(--ocean-950) 100%); }
  .ai { position: absolute; left: var(--gutter); bottom: 1rem; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(255 243 234 / 0.7); }
  @media (min-width: 60rem) { .bgv::after { background: linear-gradient(90deg, rgb(3 26 36 / 0.92) 0%, rgb(3 26 36 / 0.75) 45%, rgb(3 26 36 / 0.25) 100%), linear-gradient(180deg, var(--ocean-950) 0%, transparent 15%, transparent 85%, var(--ocean-950) 100%); } }
  .eyebrow { color: var(--gold-300); }
  .transport :global(.display em) { color: var(--gold-300); }
  .lead { color: rgb(244 236 220 / 0.8); }
  .grid { display: grid; gap: 3rem; }
  .copy { display: grid; gap: 1.25rem; }
  .steps { display: grid; }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; padding-block: 1.5rem; border-top: 1px solid rgb(227 200 143 / 0.28); }
  .steps li:last-child { border-bottom: 1px solid rgb(227 200 143 / 0.28); }
  .n { font-family: var(--font-display); font-weight: 600; font-size: 2rem; line-height: 1; color: var(--gold-300); }
  .steps h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.4rem; margin-bottom: 0.25rem; }
  .steps p { color: rgb(244 236 220 / 0.72); font-size: 0.95rem; }
  .fleet { display: grid; gap: 1rem; grid-column: 1 / -1; }
  .fleet > li { padding: 1.5rem; border: 1px solid rgb(227 200 143 / 0.28); border-radius: var(--radius); }

  /* ---------- Billete ---------- */
  .ticket { --paper: #fff3ea; --ink2: #2a1233; position: relative; display: grid; gap: 1.1rem; padding: 1.4rem 1.3rem 1.3rem; border-radius: 1.4rem; background: var(--paper); color: var(--ink2); box-shadow: 0 50px 100px -40px rgb(0 0 0 / 0.75); }
  .t-head { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: #a3365c; }
  .route { display: grid; grid-template-columns: 1fr minmax(3.5rem, 0.7fr) 1fr; align-items: end; gap: 0.5rem; }
  .end { display: grid; gap: 0.15rem; min-width: 0; }
  .end.to { text-align: right; }
  .lbl { font-size: 0.66rem; font-weight: 750; letter-spacing: 0.16em; text-transform: uppercase; color: #7a5a78; }
  .code { font-family: var(--font-display); font-weight: 420; font-size: clamp(2.4rem, 11vw, 3.6rem); line-height: 1; letter-spacing: -0.02em; }
  .ticket input { width: 100%; min-height: 2.75rem; padding: 0 0.7rem; border: 1px solid rgb(42 18 51 / 0.2); border-radius: 0.7rem; background: #fff; color: var(--ink2); font-size: 1rem; }
  .end.to input { text-align: right; }
  .ticket input:focus-visible { outline: 3px solid #a3365c; outline-offset: 1px; }
  .arc { width: 100%; height: 3.2rem; overflow: visible; margin-bottom: 3.4rem; }
  .arc path { fill: none; stroke: #a3365c; stroke-width: 1.4; stroke-dasharray: 3 5; vector-effect: non-scaling-stroke; }
  .car { fill: #a3365c; }
  .cells { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .cells label { display: grid; gap: 0.25rem; }
  .perf { position: relative; height: 0; margin: 0.3rem -1.3rem; border-top: 2px dashed rgb(42 18 51 / 0.2); }
  .perf::before, .perf::after { content: ''; position: absolute; top: -0.85rem; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--ocean-950); }
  .perf::before { left: -0.8rem; } .perf::after { right: -0.8rem; }
  .t-actions { display: grid; gap: 0.6rem; }
  .send { display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem; min-height: 3.3rem; border-radius: 999px; background: var(--wa); color: #fff; font-weight: 700; text-decoration: none; }
  .add { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 3rem; border: 1px solid rgb(42 18 51 / 0.25); border-radius: 999px; background: transparent; color: var(--ink2); font-weight: 650; }
  .add .i-check, .add[aria-pressed='true'] .i-plus { display: none; }
  .add[aria-pressed='true'] .i-check { display: inline-flex; }
  .add[aria-pressed='true'] { background: var(--ink2); color: var(--paper); }
  @media (max-width: 59.99rem) {
    .route { position: relative; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
    .arc { position: absolute; left: 32%; right: 32%; top: 1.1rem; width: auto; height: 2.4rem; margin: 0; }
  }
  @media (min-width: 60rem) {
    .ticket { padding: 2rem 2.2rem 1.8rem; transform: rotate(-1.5deg); transition: transform 0.8s var(--ease); }
    .ticket:hover, .ticket:focus-within { transform: rotate(0deg); }
    .perf { margin-inline: -2.2rem; }
    .t-actions { grid-template-columns: 1fr auto; }
  }
  @media (min-width: 60rem) {
    .grid { grid-template-columns: 1.1fr 0.9fr; gap: 5rem; align-items: center; }
    .fleet { grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
  }
</style>
