---
/**
 * Portada: secuencia de fotos a pantalla completa (fundido lento, con pausa) y cotización rápida
 * por WhatsApp para excursiones o traslados. Con movimiento reducido se queda la primera foto.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import coast from '@/assets/images/costa-punta-cana.jpg';
import lancha from '@/assets/images/lancha-rapida.jpg';
import saona from '@/assets/images/commons-isla-saona.jpg';
import buggies from '@/assets/images/buggies.jpg';
import { type Lang } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { tours } from '@/data/tours';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const q = d.quick;
const slides = [
  { src: coast, pos: '62% 50%' },
  { src: lancha, pos: '55% 55%' },
  { src: saona, pos: '50% 60%' },
  { src: buggies, pos: '50% 50%' },
];
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="slides" data-slides aria-hidden="true">
    {slides.map((s, i) => (
      <div class:list={['slide', { 'is-on': i === 0 }]}>
        <Picture src={s.src} alt="" formats={['avif', 'webp']} widths={[480, 768, 1080, 1600]} sizes="(orientation: portrait) 240vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" quality={72} style={`object-position:${s.pos}`} />
      </div>
    ))}
  </div>
  <div class="shade" aria-hidden="true"></div>

  <div class="inner shell">
    <div class="copy">
      <h1 id="hero-title"><span>{q.h1a}</span> <em>{q.h1b}</em></h1>
      <p class="lead">{q.lead}</p>
      <ul class="facts">
        {q.facts.map((f) => <li><Icon name="check" size={16} />{f}</li>)}
      </ul>
    </div>

    <form class="quick" data-quick novalidate aria-label={q.label}>
      <fieldset class="modes">
        <legend class="sr-only">{q.label}</legend>
        <label><input type="radio" name="mode" value="tour" checked /><span>{q.tabTour}</span></label>
        <label><input type="radio" name="mode" value="transfer" /><span>{q.tabTransfer}</span></label>
      </fieldset>
      <div class="fields">
        <label class="f full" data-for="tour">
          <span>{q.tour}</span>
          <select name="tour">
            <option value="">{q.tourPh}</option>
            {tours.map((x) => <option value={x.slug}>{x.name[lang]}</option>)}
          </select>
        </label>
        <label class="f full" data-for="transfer" hidden>
          <span>{q.from}</span>
          <input name="from" type="text" maxlength="120" placeholder={`${q.fromPh}…`} autocomplete="off" />
        </label>
        <label class="f full" data-for="transfer" hidden>
          <span>{q.to}</span>
          <input name="to" type="text" maxlength="120" placeholder={`${q.toPh}…`} autocomplete="off" />
        </label>
        <label class="f">
          <span>{q.date}</span>
          <input name="date" type="date" />
        </label>
        <label class="f">
          <span>{q.people}</span>
          <input name="people" type="number" inputmode="numeric" min="1" max="60" value="2" />
        </label>
      </div>
      <button type="submit" class="btn btn-wa submit"><Icon name="whatsapp" size={20} />{q.submit}</button>
      <p class="note" data-quick-status role="status" aria-live="polite">{q.note}</p>
    </form>
  </div>

  <div class="foot shell">
    <button class="ctrl" type="button" data-slides-toggle aria-pressed="false" data-label-pause={q.pause} data-label-play={q.play} aria-label={q.pause}>
      <span class="i-pause" aria-hidden="true">❚❚</span><span class="i-play" aria-hidden="true">▶</span>
    </button>
    <button class="ctrl sound" type="button" data-sound aria-pressed="false" aria-label={d.sound.label}>
      <span class="on"><Icon name="sound" /></span><span class="off"><Icon name="mute" /></span>
      <span data-sound-label>{d.sound.off}</span>
    </button>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; grid-template-rows: 1fr auto; color: var(--white); background: var(--ocean-950); overflow: clip; isolation: isolate; }
  .slides, .slide, .shade { position: absolute; inset: 0; }
  .slides { z-index: -2; }
  .slide { opacity: 0; transition: opacity 1.6s var(--ease); }
  .slide.is-on { opacity: 1; }
  .slide :global(picture), .slide :global(img) { display: block; width: 100%; height: 100%; }
  .slide :global(img) { object-fit: cover; transform: scale(1.04); }
  .slide.is-on :global(img) { animation: kb 9s linear both; }
  @keyframes kb { from { transform: scale(1.04); } to { transform: scale(1.14); } }
  .hero.is-paused .slide :global(img) { animation-play-state: paused; }
  .shade { z-index: -1; background:
    linear-gradient(180deg, rgb(3 26 36 / 0.65) 0%, rgb(3 26 36 / 0.1) 30%, rgb(3 26 36 / 0.35) 60%, rgb(3 26 36 / 0.9) 100%),
    linear-gradient(90deg, rgb(3 26 36 / 0.55) 0%, rgb(3 26 36 / 0) 70%); }

  .inner { display: grid; gap: 2rem; align-content: end; padding-top: calc(var(--header-h) + 3rem); padding-bottom: 1.5rem; }
  .copy { display: grid; gap: 1.1rem; max-width: 44rem; }
  h1 { font-family: var(--font-display); font-weight: 650; font-size: clamp(2.6rem, 10.5vw, 6.2rem); line-height: 0.95; letter-spacing: -0.045em; text-wrap: balance; animation: up 1.1s var(--ease) both; }
  h1 em { font-style: normal; color: var(--turq-300); }
  .lead { font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.55; max-width: 34rem; color: var(--white); animation: up 1.1s 0.12s var(--ease) both; }
  .facts { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.88rem; font-weight: 600; animation: up 1.1s 0.2s var(--ease) both; }
  .facts li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .facts :global(.icon) { color: var(--turq-300); }
  @keyframes up { from { opacity: 0; transform: translateY(1.25rem); } }

  .quick { display: grid; gap: 0.9rem; padding: 1rem; border-radius: 1.5rem; background: rgb(255 255 255 / 0.96); color: var(--ink); box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.6); animation: up 1.1s 0.28s var(--ease) both; }
  .modes { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem; padding: 0.25rem; margin: 0; border: 0; border-radius: 999px; background: var(--sand-100); }
  .modes label { position: relative; }
  .modes input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .modes span { display: grid; place-items: center; min-height: 2.75rem; border-radius: 999px; font-weight: 650; font-size: 0.92rem; transition: background-color 0.3s, color 0.3s; }
  .modes input:checked + span { background: var(--ink); color: var(--white); }
  .modes input:focus-visible + span { outline: 3px solid var(--turq-700); outline-offset: 2px; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .f { display: grid; gap: 0.25rem; padding: 0.55rem 0.9rem; border: 1px solid rgb(10 30 38 / 0.14); border-radius: 1rem; background: var(--white); cursor: text; }
  .f.full { grid-column: 1 / -1; }
  .f[hidden] { display: none; }
  .f span { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  .f input, .f select { border: 0; padding: 0; min-height: 1.9rem; font-size: 1rem; background: transparent; color: var(--ink); width: 100%; }
  .f input:focus-visible, .f select:focus-visible { outline: none; }
  .f:focus-within { border-color: var(--turq-700); box-shadow: 0 0 0 3px rgb(23 182 185 / 0.25); }
  .f.is-invalid { border-color: #b3261e; }
  .submit { width: 100%; min-height: 3.4rem; font-size: 1rem; }
  .note { font-size: 0.8rem; color: var(--ink-soft); text-align: center; }
  .note.is-error { color: #b3261e; font-weight: 650; }

  .foot { display: flex; justify-content: flex-end; gap: 0.5rem; padding-block: 0.75rem calc(1rem + env(safe-area-inset-bottom)); }
  .ctrl { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-width: 3rem; min-height: 3rem; padding: 0 0.9rem; border: 1px solid rgb(255 255 255 / 0.4); border-radius: 999px; background: rgb(3 26 36 / 0.35); color: var(--white); font-size: 0.8rem; font-weight: 600; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .ctrl .i-play, .ctrl[aria-pressed='true'] .i-pause { display: none; }
  .ctrl[aria-pressed='true'] .i-play { display: inline; }
  .sound .on, .sound[aria-pressed='true'] .off { display: none; }
  .sound[aria-pressed='true'] .on { display: inline; }
  .sound [data-sound-label] { display: none; }

  @media (min-width: 40rem) { .sound [data-sound-label] { display: inline; } }
  @media (min-width: 64rem) {
    .inner { grid-template-columns: minmax(0, 1fr) 25rem; align-items: end; gap: 3rem; padding-bottom: 2.5rem; }
    .quick { padding: 1.25rem; }
  }
  @media (max-height: 32rem) and (orientation: landscape) {
    h1 { font-size: clamp(2rem, 9vh, 3.2rem); }
    .lead, .facts { display: none; }
    .inner { padding-top: calc(var(--header-h) + 1rem); }
  }
  @media (prefers-reduced-motion: reduce) { .slide.is-on :global(img) { animation: none; } }
</style>
