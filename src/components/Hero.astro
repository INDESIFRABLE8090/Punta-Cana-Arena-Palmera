---
/**
 * Portada «Beyond Paradise» — Arena y Palma.
 * Fondo: escena original renderizada en Blender (océano y atardecer generados por código, no es una
 * fotografía documental). Encima: palmeras en silueta (SVG generado), titular serif con entrada letra a
 * letra (CSS puro, no espera al JS) y una orilla de espuma que lleva a la arena de la sección siguiente.
 * motion.ts escribe --p (scroll) y --mx/--my (puntero) para el paralaje; sin JS todo queda en su sitio.
 */
import Icon from './Icon.astro';
import { type Lang } from '@/i18n/config';
import { t } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const q = d.quick;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ai = { es: 'Escena ilustrativa creada con IA', en: 'Illustrative scene created with AI', pt: 'Cena ilustrativa criada com IA' }[lang];
let i = 0;
const chars = (s: string) => [...s].map((c) => ({ c, i: i++ }));
const [l1, l2] = [chars(q.lines[0]), chars(q.lines[1])];
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="scene" aria-hidden="true">
    <img class="poster" src={`${base}media/veo/sunset-1536.webp`} srcset={`${base}media/veo/sunset-900.webp 900w, ${base}media/veo/sunset-1536.webp 1536w`} sizes="(orientation: portrait) 180vw, 100vw" alt="" width="1536" height="864" fetchpriority="high" decoding="async" />
    <video class="film" data-lazy-video data-src-sm={`${base}media/veo/sunset-720.mp4`} data-src-lg={`${base}media/veo/sunset-1080.mp4`} muted loop playsinline preload="none"></video>
    <div class="glow"></div>
  </div>

  <div class="copy">
    <p class="kicker">{q.kicker}</p>
    <h1 id="hero-title">
      <span class="sr-only">{q.lines[0]} {q.lines[1]} — Arena y Palma: {q.h1a} {q.h1b}</span>
      <span class="ln" aria-hidden="true">{l1.map((x) => <span class="ch" style={`--i:${x.i}`}>{x.c}</span>)}</span>
      <span class="ln it" aria-hidden="true">{l2.map((x) => <span class="ch" style={`--i:${x.i}`}>{x.c}</span>)}</span>
    </h1>
    <p class="sub">{q.sub}</p>
  </div>

  <div class="cta">
    <p class="lead">{q.lead}</p>
    <div class="actions">
      <a class="go" href="#cotizar">{q.cta}<Icon name="arrow" size={18} /></a>
      <a class="more" href="#experiencias">{q.ctaAlt}</a>
    </div>
  </div>

  <div class="cue" aria-hidden="true"><span>{q.scroll}</span><i></i></div>

  <button class="ctrl sound" type="button" data-sound aria-pressed="false" aria-label={d.sound.label}>
    <span class="on"><Icon name="sound" /></span><span class="off"><Icon name="mute" /></span>
    <span data-sound-label>{d.sound.off}</span>
  </button>

  <p class="ai">{ai}</p>

  <svg class="shore" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path class="foam f2" d="M0 58c120 18 240 22 360 8s240-34 360-22 240 34 360 26 240-30 360-24v74H0z" />
    <path class="foam f1" d="M0 74c140-20 260-18 380-2s230 28 350 14 250-36 370-30 230 26 340 22v42H0z" />
  </svg>
</section>


<style>
  .hero {
    --p: 0; --mx: 0; --my: 0;
    --plum: #2a1233; --plum-2: #4a1f4d; --cream: #fff3e6;
    position: relative; height: 100svh; min-height: 38rem; max-height: 64rem; overflow: clip; isolation: isolate;
    color: var(--plum); background: #e9b4c8;
  }

  /* ---------- Escena renderizada ---------- */
  .scene { position: absolute; inset: 0; z-index: -2; transform: translate3d(calc(var(--mx) * 6px), calc(var(--p) * 14svh), 0) scale(calc(1.06 + var(--p) * 0.1)); transform-origin: 58% 50%; will-change: transform; }
  .poster, .film { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 58% 50%; }
  .film { opacity: 0; transition: opacity 1.4s ease; }
  .film.is-on { opacity: 1; }
  /* Halo cálido en torno al sol y viñeta suave para asentar el texto. */
  .glow { position: absolute; inset: 0; background:
    
    linear-gradient(180deg, rgb(255 210 225 / 0.28) 0%, transparent 38%, transparent 62%, rgb(13 70 84 / 0.28) 100%); }

  .ai { position: absolute; left: var(--gutter); bottom: calc(clamp(3.5rem, 9vw, 7rem) + 0.4rem); z-index: 2; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(255 255 255 / 0.8); text-shadow: 0 1px 8px rgb(13 60 74 / 0.6); }

  /* ---------- Titular ---------- */
  .copy { position: absolute; left: var(--gutter); right: var(--gutter); top: calc(var(--header-h) + 9svh); transform: translate3d(calc(var(--mx) * 10px), calc(var(--p) * -24svh), 0); opacity: calc(1 - var(--p) * 1.6); }
  .kicker { margin: 0 0 0.9rem; font-size: 0.7rem; font-weight: 750; letter-spacing: 0.22em; text-transform: uppercase; color: var(--plum); }
  h1 { margin: 0; font-family: 'Fraunces Variable', Georgia, serif; font-weight: 360; font-variation-settings: 'opsz' 144, 'SOFT' 50; font-size: clamp(4.2rem, 23vw, 15rem); line-height: 0.86; letter-spacing: -0.035em; }
  .ln { display: block; overflow: clip; padding-bottom: 0.1em; margin-bottom: -0.1em; white-space: nowrap; }
  .ln.it { font-style: italic; font-weight: 300; padding-left: 0.42em; }
  .ch { display: inline-block; }
  .sub { margin: 1rem 0 0 0.12em; font-family: 'Fraunces Variable', Georgia, serif; font-style: italic; font-size: clamp(1.1rem, 4.6vw, 1.6rem); color: var(--plum-2); }

  /* ---------- Llamada a la acción ---------- */
  .cta { position: absolute; left: var(--gutter); right: var(--gutter); bottom: calc(7.5rem + env(safe-area-inset-bottom)); display: grid; gap: 1rem; opacity: calc(1 - var(--p) * 2.4); }
  .lead { margin: 0; max-width: 26rem; font-size: 1rem; line-height: 1.5; font-weight: 500; color: var(--plum); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .go { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3.3rem; padding: 0 1.5rem 0 1.7rem; border-radius: 999px; background: var(--plum); color: var(--cream); font-weight: 700; text-decoration: none; box-shadow: 0 18px 40px -18px rgb(42 18 51 / 0.8); transition: transform 0.5s var(--ease), background-color 0.3s; }
  .go:hover { transform: translateY(-2px); background: #3b1846; }
  .go :global(.icon) { transition: transform 0.5s var(--ease); }
  .go:hover :global(.icon) { transform: translateX(4px); }
  .more { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--plum); font-weight: 700; text-decoration: underline; text-underline-offset: 0.35em; text-decoration-color: rgb(42 18 51 / 0.45); }

  .cue { position: absolute; left: 50%; bottom: calc(4.4rem + env(safe-area-inset-bottom)); display: none; translate: -50% 0; flex-direction: column; align-items: center; gap: 0.5rem; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: #fff; opacity: calc(1 - var(--p) * 4); }
  .cue i { display: block; width: 1px; height: 2.4rem; background: linear-gradient(#fff, transparent); transform-origin: top; }

  .ctrl { position: absolute; right: var(--gutter); bottom: calc(4.6rem + env(safe-area-inset-bottom)); display: inline-flex; align-items: center; gap: 0.5rem; min-width: 2.75rem; min-height: 2.75rem; padding: 0 0.8rem; justify-content: center; border: 1px solid rgb(255 255 255 / 0.6); border-radius: 999px; background: rgb(42 18 51 / 0.22); color: #fff; font-size: 0.76rem; font-weight: 650; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); opacity: calc(1 - var(--p) * 3); }
  .sound .on, .sound[aria-pressed='true'] .off { display: none; }
  .sound[aria-pressed='true'] .on { display: inline; }
  .sound [data-sound-label] { display: none; }

  /* ---------- Orilla: espuma que pasa a la arena de la sección siguiente ---------- */
  .shore { position: absolute; left: -10%; width: 120%; max-width: none; bottom: -1px; height: clamp(3.5rem, 9vw, 7rem); }
  .foam { fill: #2a1233; }
  .f2 { opacity: 0.55; }

  /* ---------- Entrada (solo con movimiento permitido) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .poster { animation: dawn 2.4s ease both; }
    .ch { animation: chin 1.25s var(--ease) both; animation-delay: calc(0.35s + var(--i) * 0.055s); }
    .kicker, .sub { animation: lift 1.2s 0.9s var(--ease) both; }
    .sub { animation-delay: 1.1s; }
    .cta { animation: lift 1.2s 1.25s var(--ease) both; }
    .cue { animation: lift 1s 1.8s ease both; }
    .cue i { animation: drip 2.2s 2s ease-in-out infinite; }
    .f1 { animation: tide 9s ease-in-out infinite alternate; }
    .f2 { animation: tide 12s ease-in-out -4s infinite alternate-reverse; }
    @keyframes dawn { from { opacity: 0; filter: saturate(0.6) brightness(1.15); } }
    @keyframes chin { from { transform: translateY(105%) rotate(6deg); opacity: 0; } }
    @keyframes lift { from { transform: translateY(1.2rem); opacity: 0; } }
    @keyframes drip { 0% { transform: scaleY(0); } 45% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
    @keyframes tide { from { transform: translateX(-1.5%); } to { transform: translateX(1.5%) translateY(6%); } }
  }

  @media (min-width: 40rem) { .sound [data-sound-label] { display: inline; } }

  /* ---------- Escritorio ---------- */
  @media (min-width: 64rem) {
    .poster, .film { object-position: 70% 50%; }
    .copy { left: 7vw; right: auto; top: calc(var(--header-h) + 7svh); }
    h1 { font-size: min(13.5vw, 25svh); }
    .ln.it { padding-left: 1.05em; }
    .sub { margin-left: 2.6em; }
    .cta { left: 7vw; right: auto; width: 30rem; bottom: calc(9rem); }
    .cue { display: flex; }
    .ctrl { bottom: 9.4rem; right: 5vw; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero { --p: 0 !important; --mx: 0 !important; --my: 0 !important; }
  }
</style>
