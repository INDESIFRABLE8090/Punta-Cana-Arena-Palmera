---
/**
 * Portada «Beyond Paradise».
 * - Una sola fotografía real (Isla Catalina, CC BY-SA 3.0) en una «ventana» que se abre al hacer scroll.
 * - Titular gigante que cruza la ventana: color arena sobre el océano y tinta sobre la foto
 *   (copia decorativa recortada por la propia ventana, así el cruce es exacto en cualquier pantalla).
 * - Todo el movimiento depende de tres variables CSS (--e, --p, --mx/--my) que escribe motion.ts;
 *   sin JavaScript o con movimiento reducido la composición queda completa y estática.
 * - La cotización rápida (data-quick) vive en la franja inferior; el h1 conserva el texto SEO.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import photo from '@/assets/images/commons-isla-catalina.jpg';
import { type Lang } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { tours } from '@/data/tours';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const q = d.quick;
const [line1, line2] = q.lines;
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="track" data-track>
  <div class="stage" data-stage>
    <div class="window" data-window>
      <div class="photo" data-photo>
        <Picture src={photo} alt={q.photoAlt} formats={['avif', 'webp']} widths={[768, 1080, 1600, 2200, 3000]} sizes="(min-width: 64rem) 100vw, 190vw" loading="eager" fetchpriority="high" decoding="async" quality={74} />
      </div>
      <div class="shine" aria-hidden="true"></div>
      <!-- Copia decorativa en tinta: queda dentro de la ventana, así solo se ve sobre la foto. -->
      <div class="type type-ink" aria-hidden="true">
        <span class="big"><span class="ln"><span>{line1}</span></span><span class="ln"><span><em>{line2}</em></span></span></span>
      </div>
      <p class="caption">{q.caption}</p>
    </div>

    <div class="type type-sand" data-type>
      <h1 id="hero-title">
        <span class="kicker"><span>{q.h1a} {q.h1b}</span></span>
        <span class="big"><span class="ln"><span>{line1}</span></span><span class="ln"><span><em>{line2}</em></span></span></span>
      </h1>
    </div>

    <div class="cta" data-cta>
      <p class="lead">{q.lead}</p>
      <div class="actions">
        <a class="go" href="#cotizar">{q.cta}</a>
        <a class="more" href="#experiencias">{q.ctaAlt}</a>
      </div>
    </div>

    <button class="ctrl sound" type="button" data-sound aria-pressed="false" aria-label={d.sound.label}>
      <span class="on"><Icon name="sound" /></span><span class="off"><Icon name="mute" /></span>
      <span data-sound-label>{d.sound.off}</span>
    </button>
  </div>
  </div>

  <div class="bar" id="cotizar">
    <form class="quick shell" data-quick novalidate aria-label={q.label}>
      <p class="tag" aria-hidden="true">{q.tagline}</p>
      <fieldset class="modes">
        <legend class="sr-only">{q.label}</legend>
        <label><input type="radio" name="mode" value="tour" checked /><span>{q.tabTour}</span></label>
        <label><input type="radio" name="mode" value="transfer" /><span>{q.tabTransfer}</span></label>
      </fieldset>
      <div class="fields">
        <label class="f" data-for="tour">
          <span>{q.tour}</span>
          <select name="tour">
            <option value="">{q.tourPh}</option>
            {tours.map((x) => <option value={x.slug}>{x.name[lang]}</option>)}
          </select>
        </label>
        <label class="f" data-for="transfer" hidden>
          <span>{q.from}</span>
          <input name="from" type="text" maxlength="120" placeholder={`${q.fromPh}…`} autocomplete="off" />
        </label>
        <label class="f" data-for="transfer" hidden>
          <span>{q.to}</span>
          <input name="to" type="text" maxlength="120" placeholder={`${q.toPh}…`} autocomplete="off" />
        </label>
        <label class="f">
          <span>{q.date}</span>
          <input name="date" type="date" />
        </label>
        <label class="f">
          <span>{q.people}</span>
          <input name="people" type="number" inputmode="numeric" min="1" max="60" value="2" />
        </label>
      </div>
      <button type="submit" class="btn btn-wa submit"><Icon name="whatsapp" size={20} />{q.submit}</button>
      <p class="note" data-quick-status role="status" aria-live="polite">{q.note}</p>
    </form>
  </div>
</section>

<style>
  .hero { position: relative; color: var(--white); background: var(--ocean-950); }
  /* Con JS y movimiento permitido el escenario queda fijo mientras la ventana se abre (scroll nativo, sin secuestrarlo). */
  .track { position: relative; }
  .hero.is-live .track { height: 190svh; }
  .hero.is-live .stage { position: sticky; top: 0; }

  /* ---------- Escenario: unidades de contenedor (cqw/cqh) = % real del escenario ---------- */
  .stage {
    --e: 0; --p: 0; --mx: 0; --my: 0;
    /* Ventana en reposo (móvil) y su interpolación hacia pantalla completa (--e: 0 → 1). */
    --l0: 5cqw; --t0: 25cqh; --r0: 5cqw; --b0: 28cqh; --rad0: 1.75rem;
    --wl: calc(var(--l0) * (1 - var(--e)));
    --wt: calc(var(--t0) * (1 - var(--e)));
    --wr: calc(var(--r0) * (1 - var(--e)));
    --wb: calc(var(--b0) * (1 - var(--e)));
    position: relative; height: 100svh; min-height: 36rem; max-height: 62rem;
    container-type: size; overflow: clip; isolation: isolate;
    background:
      radial-gradient(120% 70% at 85% 0%, rgb(14 154 163 / 0.28), transparent 60%),
      radial-gradient(90% 60% at 0% 100%, rgb(11 76 96 / 0.7), transparent 65%),
      var(--ocean-950);
  }
  .window {
    position: absolute; z-index: 1; overflow: clip;
    left: var(--wl); top: var(--wt); right: var(--wr); bottom: var(--wb);
    border-radius: calc(var(--rad0) * (1 - var(--e)));
    background: var(--ocean-800);
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.75);
  }
  .photo { position: absolute; inset: -4% -3%; will-change: transform;
    transform: translate3d(calc(var(--mx) * 12px), calc(var(--p) * 7cqh + var(--my) * 8px), 0) scale(1.04); }
  .photo :global(picture), .photo :global(img) { display: block; width: 100%; height: 100%; }
  .photo :global(img) { object-fit: cover; object-position: 22% 62%; }
  /* Velo ligero para unir la foto con el océano; el centro queda limpio y nítido. */
  .shine { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgb(3 26 36 / 0.18) 0%, transparent 22%, transparent 70%, rgb(3 26 36 / 0.55) 100%); }
  .caption { position: absolute; left: 1rem; bottom: 0.8rem; white-space: nowrap; font-size: 0.64rem; font-weight: 600; letter-spacing: 0.04em; color: rgb(255 255 255 / 0.92); text-shadow: 0 1px 8px rgb(0 0 0 / 0.6); opacity: calc(1 - var(--e) * 2); }

  /* ---------- Titular ---------- */
  .type { position: absolute; z-index: 2; left: 0; top: 0; width: 100cqw; height: 100cqh; pointer-events: none;
    transform: translate3d(calc(var(--mx) * -16px), calc(var(--p) * -30cqh + var(--my) * -10px), 0); }
  .type-sand { z-index: 0; opacity: calc(1 - var(--e) * 1.15); }
  /* La copia tinta va dentro de la ventana: su caja se desplaza para coincidir con la de arena. */
  .type-ink { z-index: 2; left: calc(var(--wl) * -1); top: calc(var(--wt) * -1); }
  .type-ink .big { color: var(--ocean-950); }
  h1 { margin: 0; font-weight: 400; }
  .kicker { position: absolute; left: 5cqw; top: calc(var(--header-h) + 1.1rem); display: block; max-width: 92cqw; font-family: var(--font-body); font-size: clamp(0.58rem, 2.75cqw, 0.74rem); font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: var(--turq-300); white-space: nowrap; }
  .big { position: absolute; left: 4.5cqw; top: calc(var(--header-h) + 3rem); display: block; font-family: 'Fraunces Variable', 'Outfit Variable', Georgia, serif; font-weight: 420; font-variation-settings: 'opsz' 144, 'SOFT' 0;
    font-size: 17.5cqw; line-height: 0.9; letter-spacing: -0.045em; color: var(--sand-200); text-wrap: nowrap; }
  .type-ink .big { color: var(--ocean-950); }
  .ln { display: block; overflow: clip; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .ln > span { display: block; }
  .ln:nth-child(2) { padding-left: 0.08em; }
  .big em { font-style: italic; font-weight: 380; font-variation-settings: 'opsz' 144, 'SOFT' 100; }

  /* ---------- Entradilla y CTA ---------- */
  .cta { position: absolute; z-index: 3; left: 5cqw; right: 5cqw; bottom: 3.2cqh; display: grid; gap: 0.85rem; opacity: calc(1 - var(--e) * 2.2); }
  .lead { margin: 0; max-width: 30rem; font-size: 0.98rem; line-height: 1.5; color: rgb(255 255 255 / 0.9); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.4rem; }
  .go { display: inline-flex; align-items: center; min-height: 3.2rem; padding: 0 1.6rem; border-radius: 999px; background: var(--sand-200); color: var(--ocean-950); font-weight: 700; font-size: 1rem; text-decoration: none; transition: transform 0.4s var(--ease), background-color 0.3s; }
  .go:hover { transform: translateY(-2px); background: var(--white); }
  .more { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 650; font-size: 0.95rem; color: var(--white); text-decoration: underline; text-underline-offset: 0.35em; text-decoration-color: rgb(255 255 255 / 0.4); }
  .more:hover { text-decoration-color: var(--turq-300); }

  .ctrl { position: absolute; z-index: 3; right: 5cqw; top: calc(var(--t0) + 0.8rem); display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-width: 2.75rem; min-height: 2.75rem; padding: 0 0.8rem; border: 1px solid rgb(255 255 255 / 0.5); border-radius: 999px; background: rgb(3 26 36 / 0.4); color: var(--white); font-size: 0.78rem; font-weight: 600; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); opacity: calc(1 - var(--e) * 2); }
  .sound .on, .sound[aria-pressed='true'] .off { display: none; }
  .sound[aria-pressed='true'] .on { display: inline; }
  .sound [data-sound-label] { display: none; }

  /* ---------- Franja de cotización ---------- */
  .bar { background: var(--ocean-900); padding-block: 1.1rem 1.4rem; border-top: 1px solid rgb(127 220 214 / 0.18); }
  .quick { display: grid; gap: 0.6rem; }
  .tag { display: none; margin: 0; font-family: 'Fraunces Variable', Georgia, serif; font-style: italic; font-size: 1.35rem; color: var(--sand-200); }
  .modes { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem; padding: 0.25rem; margin: 0; border: 0; border-radius: 999px; background: rgb(255 255 255 / 0.08); }
  .modes label { position: relative; }
  .modes input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .modes span { display: grid; place-items: center; min-height: 2.6rem; border-radius: 999px; font-weight: 650; font-size: 0.9rem; color: var(--white); transition: background-color 0.3s, color 0.3s; }
  .modes input:checked + span { background: var(--sand-200); color: var(--ocean-950); }
  .modes input:focus-visible + span { outline: 3px solid var(--turq-300); outline-offset: 2px; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .f { display: grid; gap: 0.1rem; padding: 0.4rem 0.85rem; border: 1px solid rgb(255 255 255 / 0.16); border-radius: 1rem; background: rgb(255 255 255 / 0.96); color: var(--ink); cursor: text; }
  .f[data-for] { grid-column: 1 / -1; }
  .f[hidden] { display: none; }
  .f span { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  .f input, .f select { border: 0; padding: 0; min-height: 1.6rem; font-size: 1rem; background: transparent; color: var(--ink); width: 100%; }
  .f input:focus-visible, .f select:focus-visible { outline: none; }
  .f:focus-within { border-color: var(--turq-300); box-shadow: 0 0 0 3px rgb(127 220 214 / 0.4); }
  .f.is-invalid { border-color: #ff9b94; box-shadow: 0 0 0 3px rgb(255 155 148 / 0.35); }
  .submit { width: 100%; min-height: 3.1rem; font-size: 1rem; }
  .note { margin: 0; font-size: 0.74rem; line-height: 1.35; color: rgb(255 255 255 / 0.74); text-align: center; }
  .note.is-error { color: #ffb4ad; font-weight: 650; }

  /* ---------- Intro (solo con movimiento permitido) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .window { animation: open 1.35s var(--ease) both; }
    .photo { animation: settle 1.9s var(--ease) both; }
    .ln > span { animation: rise 1.1s var(--ease) both; }
    .ln:nth-child(2) > span { animation-delay: 0.12s; }
    .kicker > span { display: block; animation: rise 0.9s 0.05s var(--ease) both; }
    .cta { animation: fade 1s 0.7s var(--ease) both; }
    .caption, .ctrl { animation: fade 1s 1s ease both; }
    @keyframes open { from { clip-path: inset(14% 9% 14% 9% round 2.2rem); } to { clip-path: inset(0 0 0 0 round 0); } }
    @keyframes settle { from { scale: 1.16; } to { scale: 1; } }
    @keyframes rise { from { transform: translateY(105%); } }
    @keyframes fade { from { opacity: 0; } }
  }

  @media (min-width: 40rem) { .sound [data-sound-label] { display: inline; } }

  /* ---------- Escritorio ---------- */
  @media (min-width: 64rem) {
    .stage { --l0: 41cqw; --t0: 16cqh; --r0: 4cqw; --b0: 13cqh; --rad0: 2.25rem; }
    .kicker { left: 4cqw; font-size: 0.8rem; }
    .big { left: 3.5cqw; top: calc(var(--header-h) + 4.2rem); font-size: min(10.6cqw, 21cqh); }
    .ln:nth-child(2) { padding-left: 0.95em; }
    .cta { left: 4cqw; right: auto; width: min(32rem, 34cqw); bottom: 8cqh; gap: 1.1rem; }
    .lead { font-size: 1.08rem; }
    .ctrl { right: 5.4cqw; top: auto; bottom: calc(var(--b0) + 1rem); }
    .caption { left: 1.4rem; bottom: 1.1rem; font-size: 0.74rem; }
    .quick { grid-template-columns: auto minmax(0, 1fr) auto; align-items: end; column-gap: 1.25rem; row-gap: 0.7rem; }
    .tag { display: block; grid-column: 1 / -1; }
    .modes { width: 16rem; }
    .fields { grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); }
    .f[data-for] { grid-column: auto; }
    .f[data-for='tour'] { min-width: 14rem; }
    .submit { width: auto; padding-inline: 1.75rem; }
    .note { grid-column: 1 / -1; text-align: left; }
  }

  @media (max-width: 63.99rem) and (max-height: 40rem) { .stage { --t0: 38cqh; --b0: 30cqh; } .big { font-size: 15cqw; } }

  @media (prefers-reduced-motion: reduce) {
    .stage { --e: 0 !important; --p: 0 !important; --mx: 0 !important; --my: 0 !important; }
  }
</style>
