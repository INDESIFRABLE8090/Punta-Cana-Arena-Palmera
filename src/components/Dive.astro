---
/**
 * Vuelo sobre la costa: escena publicitaria creada con IA (Google Veo) fijada mientras el texto avanza con
 * el scroll (motion.ts → initDive). Sustituye a la escena Three.js: más ligera en Android.
 * El vídeo solo se descarga con movimiento permitido, sin ahorro de datos y cuando la sección se acerca.
 */
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).dive;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ai = { es: 'Escena ilustrativa creada con IA', en: 'Illustrative scene created with AI', pt: 'Cena ilustrativa criada com IA' }[lang];
---

<section class="dive" data-dive aria-label={d.label}>
  <div class="stage">
    <div class="fallback" aria-hidden="true">
      <img src={`${base}media/veo/coast-1536.webp`} srcset={`${base}media/veo/coast-900.webp 900w, ${base}media/veo/coast-1536.webp 1536w`} sizes="100vw" alt="" width="1536" height="864" loading="lazy" decoding="async" />
      <video data-lazy-video data-src-sm={`${base}media/veo/coast-720.mp4`} data-src-lg={`${base}media/veo/coast-1080.mp4`} muted loop playsinline preload="none"></video>
      <div class="deep" data-dive-deep></div>
    </div>
    <div class="veil" data-dive-veil aria-hidden="true"></div>
    <div class="lines shell">
      <p class="display" data-dive-line>{d.line1}</p>
      <p class="display" data-dive-line>{d.line2}</p>
      <p class="display" data-dive-line>{d.line3}</p>
      <p class="display" data-dive-line><em>{d.line4}</em></p>
    </div>
    <div class="depth" aria-hidden="true"><span data-dive-depth></span><i><b data-dive-bar></b></i></div>
    <p class="ai">{ai}</p>
  </div>
</section>
<script is:inline>
  // Modo con scroll solo si el movimiento está permitido (sin 3D: la escena es vídeo).
  (function () {
    var el = document.currentScript.previousElementSibling;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) el.classList.add('is-live');
  })();
</script>

<style>
  .dive { position: relative; background: var(--ocean-900); color: #fff3ea; }
  .stage { position: relative; min-height: 100svh; overflow: clip; display: grid; }
  .fallback, .veil { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fallback img, .fallback video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 64% 50%; }
  .fallback video { opacity: 0; transition: opacity 1.2s ease; }
  .fallback video.is-on { opacity: 1; }
  /* Velo que asienta el texto y, al final, funde al océano profundo del transporte. */
  .deep { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(5 36 47 / 0.15) 0%, rgb(5 36 47 / 0.35) 55%, rgb(5 36 47 / 0.75) 100%); opacity: calc(0.6 + var(--deep, 0) * 0.4); }
  .veil { pointer-events: none; opacity: 0; background: var(--ocean-950); }
  .lines { position: relative; align-self: center; display: grid; gap: 1.5rem; padding-block: 6rem; }
  .lines p { font-size: clamp(2.2rem, 8.5vw, 6rem); max-width: 15ch; color: #fff3ea; text-shadow: 0 2px 30px rgb(5 36 47 / 0.55); }
  .lines em { color: #fff3ea; }
  .lines p:last-child { font-size:clamp(2.6rem,9vw,6.7rem); max-width:16ch; text-wrap:balance; }
  .fallback { transform:scale(calc(1.04 + var(--welcome-p,0) * .06)); transform-origin:64% 50%; }
  .depth { display: none; }
  .ai { position: absolute; left: var(--gutter); bottom: calc(1rem + env(safe-area-inset-bottom)); z-index: 3; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(255 243 234 / 0.75); }
  /* Shorter welcome chapter: retain the full message without a 3-screen hold. */
  .dive.is-live { height: 230svh; }
  @media (min-width: 64rem) { .dive.is-live { height: 260svh; } }
  .dive.is-live .stage { position: sticky; top: 0; height: 100svh; min-height: 0; }
  .dive.is-live .lines { position: absolute; inset: 0; padding-block: 0; display: block; z-index: 2; }
  .dive.is-live .lines p { position: absolute; left: var(--gutter); right: var(--gutter); top: 50%; opacity: 0; transform: translateY(-50%); will-change: opacity, transform; }
  .dive.is-live .veil { z-index: 2; }
</style>
