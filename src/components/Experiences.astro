---
import TourChapter from './TourChapter.astro';
import SplitHeading from './SplitHeading.astro';
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/config';
import { tours, type Category } from '@/data/tours';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const cats: Category[] = ['sea', 'adventure', 'nature', 'night'];
---

<section class="section experiences" id="experiencias" aria-labelledby="exp-title">
  <div class="shell">
    <div class="section-head">
      <p class="eyebrow" data-reveal>{d.experiences.eyebrow}</p>
      <SplitHeading class="h-xl" id="exp-title" text={d.experiences.title} em={d.experiences.titleEm} />
      <p class="lead" data-reveal style="--i:2">{d.experiences.lead}</p>
      <div class="filters" role="group" aria-label={d.experiences.filterLabel} data-reveal style="--i:3">
        <button type="button" class="chip" data-filter="all" aria-pressed="true">{d.experiences.all}</button>
        {cats.map((c) => <button type="button" class="chip" data-filter={c} aria-pressed="false">{d.categories[c]}</button>)}
      </div>
    </div>
    <ol class="chapters" data-chapters>
      {tours.map((tour, i) => <TourChapter lang={lang} tour={tour} index={i} />)}
    </ol>
    <p class="price-note">{d.experiences.priceNote}</p>
  </div>
</section>

<style>
  .experiences { background: var(--sand-50); }
  .filters { display: flex; gap: 0.5rem; overflow-x: auto; margin-inline: calc(var(--gutter) * -1); padding: 0.25rem var(--gutter); scrollbar-width: none; }
  .filters::-webkit-scrollbar { display: none; }
  .chip { flex: none; min-height: 3rem; padding: 0 1.25rem; border-radius: 999px; border: 1px solid rgb(10 30 38 / 0.25); font-weight: 650; font-size: 0.9rem; transition: background-color 0.3s, color 0.3s, border-color 0.3s; }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--white); border-color: var(--ink); }
  .chapters { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(3.5rem, 9vw, 8rem) clamp(1rem, 2vw, 2rem); }
  .chapters :global(.chapter[hidden]) { display: none; }
  .chapters :global(.is-poster + .is-poster) { margin-top: calc(clamp(3.5rem, 9vw, 8rem) * -1 + 1rem); }
  .price-note { margin-top: clamp(3rem, 6vw, 5rem); padding-top: 1.25rem; border-top: 1px solid rgb(10 30 38 / 0.15); font-size: 0.9rem; color: var(--ink-soft); max-width: 44rem; }
  @media (min-width: 48rem) {
    .chapters :global(.is-poster + .is-poster) { margin-top: 5rem; }
  }
</style>
