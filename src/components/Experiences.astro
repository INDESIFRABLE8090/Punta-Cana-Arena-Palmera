---
/** Final Cut: responsive editorial grid. Preserve filter, itinerary, link and reveal contracts. */
import { Picture, getImage } from 'astro:assets';
import Gallery from './Gallery.astro';
import { creditFor } from '@/data/credits';
import { legalUi } from '@/i18n/legal';
import SplitHeading from './SplitHeading.astro';
import AddButton from './AddButton.astro';
import Icon from './Icon.astro';
import { t } from '@/i18n/ui';
import { tourPath, type Lang } from '@/i18n/config';
import { tours, type Category } from '@/data/tours';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const cats: Category[] = ['sea', 'adventure', 'nature', 'night'];
const pad = (n: number) => String(n).padStart(2, '0');
const soon = { es: 'Foto próximamente', en: 'Photo coming soon', pt: 'Foto em breve' }[lang];
const illus = { es: 'Imagen ilustrativa', en: 'Illustrative image', pt: 'Imagem ilustrativa' }[lang];
// One rendering of each licensed photo on the home page, with full size available on demand.
const licensed = tours.filter((tour) => tour.image?.credit && ['commons-isla-catalina.jpg', 'commons-isla-saona.jpg', 'commons-mono-ardilla.jpg'].includes(tour.image.credit));
const photos = new Map(await Promise.all(licensed.map(async (tour, index) => {
  const image = tour.image!;
  const full = await getImage({ src: image.src, width: Math.min(2400, image.src.width), format: 'webp', quality: 82 });
  return [tour.slug, { index, full: full.src, alt: image.alt[lang], credit: creditFor(image.credit!) }] as const;
})));
const highlights = (i: number) => {
  const tour = tours[i]!;
  return (tour.options ? tour.options.map((o) => o.name[lang]) : tour.inclusions[lang].slice(1)).slice(0, 3);
};
---

<section class="experiences" id="experiencias" aria-labelledby="exp-title" data-index>
  <div class="shell top">
    <p class="eyebrow">{d.experiences.eyebrow}</p>
    <SplitHeading class="h-xl" id="exp-title" text={d.experiences.title} em={d.experiences.titleEm} />
    <p class="intro">{d.experiences.lead}</p>
    <div class="filters" role="group" aria-label={d.experiences.filterLabel}>
      <button type="button" class="chip" data-filter="all" aria-pressed="true">{d.experiences.all}</button>
      {cats.map((c) => <button type="button" class="chip" data-filter={c} aria-pressed="false">{d.categories[c]}</button>)}
    </div>
  </div>

  <div class="shell grid" id="galeria">
    <ol class="list" data-chapters>
      {tours.map((tour, i) => {
        const photo = photos.get(tour.slug);
        return (<li class="row" data-category={tour.category} data-slug={tour.slug} style={`--accent:${tour.accent};--deep:${tour.deep}`}>
          <a class="hit" href={tourPath(lang, tour.slug)} data-index-link>
            <span class="meta"><span class="num">{pad(i + 1)}</span><span class="cat">{d.categories[tour.category]}</span></span>
            <span class="name">{tour.name[lang]}</span>
            <span class="tag">{tour.tagline[lang]}</span>
          </a>
          <figure class="shot" aria-hidden="true">
            {tour.image ? (
              <Picture src={tour.image.src} alt="" formats={['avif', 'webp']} widths={[480, 768, 1080]} sizes={([0, 3, 7, 10].includes(i) ? "(min-width: 64rem) 62vw, 92vw" : [6].includes(i) ? "(min-width: 64rem) 32vw, 92vw" : "(min-width: 64rem) 32vw, (min-width: 361px) 46vw, 92vw")} loading="lazy" decoding="async" quality={72} style={`object-position:${tour.image.position ?? '50% 50%'}`} />
            ) : <span class="poster"><span class="pname">{tour.name[lang]}</span><span class="soon">{soon}</span></span>}
          </figure>
          {tour.image && !tour.image.credit && <p class="il-m">{illus}</p>}
          {photo?.credit && <small class="credit">{legalUi[lang].photo}: {photo.credit.author} · {photo.credit.license}</small>}
          <p class="incl">{highlights(i).join(' · ')}</p>
          <div class="actions">
            <a class="view" href={tourPath(lang, tour.slug)}>{d.experiences.view}<Icon name="arrow" size={16} /></a>
            <AddButton lang={lang} slug={tour.slug} class="add" />
            {photo && <button type="button" class="zoom" data-shot={photo.index} data-full={photo.full} data-alt={photo.alt} data-caption={`${tour.name[lang]} · ${legalUi[lang].photo}: ${photo.credit?.author} (${photo.credit?.license})`} aria-label={`${d.gallery.open}: ${tour.name[lang]}`}>{d.gallery.open}</button>}
          </div>
        </li>);
      })}
    </ol>

  </div>
  <p class="shell price-note">{d.experiences.priceNote}</p>
  <Gallery lang={lang} />
</section>

<style>

  .experiences {
    position:relative; padding-block:clamp(5rem,12vw,9rem) 4rem;
    background:radial-gradient(ellipse at 15% 12%,#42243e 0%,transparent 43%),radial-gradient(ellipse at 85% 70%,#123a43 0%,transparent 50%),#111929;
    color:#f6e9e2;
  }
  .top {display:grid;gap:1.1rem;margin-bottom:clamp(2.5rem,6vw,4.5rem)}
  .top .eyebrow,.top :global(.display em){color:#f2a7bf}
  .top :global(.display){color:#fff3ea}
  .intro{max-width:34rem;font-size:1.05rem;line-height:1.6;color:#e0d0d2}
  .filters{display:flex;gap:.35rem;overflow-x:auto;margin:.5rem calc(var(--gutter)* -1) 0;padding:0 var(--gutter);scrollbar-width:none}
  .filters::-webkit-scrollbar{display:none}
  .chip{flex:none;min-height:44px;padding:0 1.05rem;border:1px solid #9b879a;border-radius:999px;background:transparent;color:#f6e9e2;font-weight:650;font-size:.88rem}
  .chip:hover{border-color:#fff3ea}
  .chip[aria-pressed=true]{background:#f6e9e2;color:#2a1233;border-color:#f6e9e2}
  .list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(.7rem,2vw,1.4rem)}
  .row{position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:flex-end;min-width:0;min-height:19rem;gap:.55rem;padding:clamp(.9rem,2vw,1.7rem);border-radius:1.5rem;overflow:hidden;border:1px solid rgb(255 255 255 / .16);background:var(--deep);box-shadow:0 18px 48px -26px #000}
  .row[hidden]{display:none}
  .row .shot{position:absolute;inset:0;margin:0;z-index:-2;overflow:hidden;background:var(--deep)}
  .shot :global(picture),.shot :global(img){display:block;width:100%;height:100%}
  .shot :global(img){object-fit:cover}
  .row::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(180deg,rgb(0 0 0 / .04),rgb(7 13 22 / .30) 26%,rgb(7 13 22 / .91) 66%,#070d16 100%)}
  .hit{display:grid;gap:.4rem;color:white;text-decoration:none}
  .meta{display:flex;gap:.5rem;align-items:baseline;font-size:.66rem;font-weight:750;letter-spacing:.1em;text-transform:uppercase;color:#fff3ea}
  .num{font-variant-numeric:tabular-nums;color:#fff3ea}
  .name{font-family:var(--font-display);font-weight:380;font-variation-settings:'opsz' 144,'SOFT' 50;font-size:clamp(1.55rem,6vw,3.8rem);line-height:1.04;letter-spacing:-.035em;color:#fff3ea;overflow-wrap:anywhere}
  .tag{font-family:var(--font-display);font-style:italic;font-size:clamp(.9rem,2.9vw,1.2rem);color:#fff3ea}
  .poster{position:absolute;inset:0;display:grid;align-content:start;padding:1rem;background:radial-gradient(ellipse at 65% 15%,var(--accent),transparent 70%),linear-gradient(160deg,var(--deep),#111929)}
  .pname{display:none}
  .soon{font-size:.68rem;font-weight:750;letter-spacing:.12em;text-transform:uppercase;color:white;background:#111929;padding:.35rem .5rem;justify-self:start;border-radius:.25rem}
  .il-m{margin:0;font-size:.63rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:#f1e5df}
  .incl{display:none;color:#f6e9e2;font-size:.85rem}
  .actions{display:flex;flex-wrap:wrap;align-items:center;gap:.25rem .6rem}
  .view{display:inline-flex;align-items:center;gap:.3rem;min-height:44px;font-weight:700;font-size:.8rem;color:#fff3ea;text-decoration:underline;text-underline-offset:.3em}
  .actions :global(.add){display:inline-flex;align-items:center;gap:.35rem;min-height:44px;padding:0 .65rem;border:1px solid #b0a1b0;border-radius:999px;background:#111929;color:#f6e9e2;font-weight:650;font-size:.75rem}
  .actions :global(.add[aria-pressed=true]){background:#f2a7bf;color:#2a1233;border-color:#f2a7bf}
  .credit{font-size:.65rem;line-height:1.45;color:#e0d0d2}
  .zoom{display:inline-flex;align-items:center;min-height:44px;padding:0 .65rem;border-radius:999px;border:1px solid #b0a1b0;background:#111929;color:#fff3ea;font-size:.76rem}
  .price-note{margin-top:2rem;font-size:.86rem;color:#e0d0d2}
  @media(min-width:361px){
    .list{grid-template-columns:repeat(2,minmax(0,1fr))}
    .row:is(:nth-child(1),:nth-child(4),:nth-child(7)){grid-column:span 2;min-height:23rem}
    .row:is(:nth-child(1),:nth-child(4),:nth-child(7)) .name{font-size:clamp(2.45rem,8vw,5.2rem)}
    .list:has(>.row[hidden])>.row:not([hidden]){grid-column:span 1;min-height:19rem}
    .list:has(>.row[hidden])>.row:not([hidden]) .name{font-size:clamp(1.55rem,5.6vw,3.6rem)}
    .list:has(>.row[hidden])>.row:nth-child(odd of :not([hidden])):nth-last-child(1 of :not([hidden])){grid-column:1/-1}
  }
  @media(min-width:64rem){
    .list{grid-template-columns:repeat(3,minmax(0,1fr))}
    .row{min-height:25rem}
    .row:nth-child(7){grid-column:span 1;min-height:25rem}
    .row:is(:nth-child(1),:nth-child(4),:nth-child(8),:nth-child(11)){grid-column:span 2;min-height:28rem}
    .row .name,.row:nth-child(7) .name{font-size:clamp(1.8rem,3vw,3.6rem)}
    .row:is(:nth-child(1),:nth-child(4),:nth-child(8),:nth-child(11)) .name{font-size:clamp(2.8rem,5vw,5rem)}
    .row .incl{display:block}
    .row .actions :global(.add),.row .view{font-size:.86rem}
    .list:has(>.row[hidden]){grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  /* Motion uses native scroll, not wheel/touch interception. Controls stay stationary. */
  @keyframes final-cut-depth{from{transform:translateY(-3%) scale(1.1)}to{transform:translateY(3%) scale(1.1)}}
  @media(prefers-reduced-motion:no-preference){
    .shot :global(img){scale:1.08;transition:scale 1s var(--ease)}
    .row.is-in .shot :global(img){scale:1.02}
    @media(hover:hover) and (pointer:fine){
      .row:hover .shot :global(img),.row:focus-within .shot :global(img){scale:1.09}
    }
    @supports(animation-timeline:view()){
      .row .shot :global(picture){animation:final-cut-depth linear both;animation-timeline:view();animation-range:entry 0% exit 100%}
    }
  }
</style>
