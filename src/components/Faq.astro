---
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).faq;
---
<section class="section faq" id="preguntas" aria-labelledby="faq-title">
  <div class="shell grid">
    <div class="section-head">
      <p class="eyebrow" data-reveal>{d.eyebrow}</p>
      <h2 class="display h-lg" id="faq-title" data-reveal style="--i:1">{d.title} <em>{d.titleEm}</em></h2>
    </div>
    <div class="list">
      {d.items.map((it, i) => (
        <details data-reveal style={`--i:${i % 4}`} name="faq">
          <summary><h3>{it.q}</h3><span aria-hidden="true"></span></summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq { background: var(--sand-50); }
  .grid { display: grid; gap: 1rem; }
  details { border-top: 1px solid rgb(10 30 38 / 0.15); }
  details:last-child { border-bottom: 1px solid rgb(10 30 38 / 0.15); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 4rem; padding-block: 1rem; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font-family: var(--font-display); font-weight: 380; font-size: clamp(1.2rem, 2.4vw, 1.5rem); line-height: 1.25; }
  summary span { flex: none; width: 2.5rem; height: 2.5rem; border-radius: 999px; border: 1px solid rgb(10 30 38 / 0.25); position: relative; transition: transform 0.5s var(--ease), background-color 0.3s; }
  summary span::before, summary span::after { content: ''; position: absolute; top: 50%; left: 50%; width: 0.9rem; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); }
  summary span::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform 0.5s var(--ease); }
  details[open] summary span { background: var(--ink); color: var(--white); transform: rotate(180deg); }
  details[open] summary span::after { transform: translate(-50%, -50%) rotate(0); }
  details p { padding-bottom: 1.5rem; max-width: 42rem; color: var(--ink-soft); }
  @media (min-width: 60rem) { .grid { grid-template-columns: 0.8fr 1.2fr; gap: 5rem; } .section-head { position: sticky; top: 7rem; align-self: start; } }
</style>
