---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import AddButton from './AddButton.astro';
import { tourPath, type Lang } from '@/i18n/config';
import { t } from '@/i18n/ui';
import type { Tour } from '@/data/tours';

interface Props { lang: Lang; tour: Tour; index?: number }
const { lang, tour } = Astro.props;
const d = t(lang);
/** Composición propia de cada capítulo con fotografía. */
const layouts: Record<string, string> = {
  'scuba-doo': 'cinema',
  'buggies-polaris-atv': 'right',
  'dolphin-explorer': 'left',
  'lancha-rapida': 'offset',
  'coco-bongo': 'night',
};
const layout = tour.image ? (layouts[tour.slug] ?? 'left') : 'poster';
const highlights = (tour.options ? tour.options.map((o) => o.name[lang]) : tour.inclusions[lang].slice(1)).slice(0, layout === 'poster' ? 6 : 4);
const url = tourPath(lang, tour.slug);
---

<li class:list={['chapter', `is-${layout}`]} data-category={tour.category} style={`--accent:${tour.accent};--deep:${tour.deep}`}>
  <article>
    {tour.image && (
      <a class="figure" href={url} tabindex="-1" aria-hidden="true" data-reveal="mask">
        <span class="zoom" data-parallax>
          <Picture src={tour.image.src} alt="" formats={['webp']} widths={[480, 768, 1080, 1440]} sizes={layout === 'cinema' || layout === 'night' ? '100vw' : '(min-width: 64rem) 58vw, 100vw'} loading="lazy" decoding="async" quality={68} style={`object-position:${tour.image.position ?? '50% 50%'}`} />
        </span>
      </a>
    )}
    {layout === 'poster' && <div class="caustics" aria-hidden="true"></div>}
    <div class="body">
      <p class="meta">{d.categories[tour.category]}</p>
      <h3 class="display"><a href={url}>{tour.name[lang]}</a></h3>
      <p class="tagline">{tour.tagline[lang]}</p>
      <ul class="highlights" aria-label={d.experiences.includes}>
        {highlights.map((h) => <li>{h}</li>)}
      </ul>
      <div class="actions">
        <a class="btn btn-solid" href={url}>{d.experiences.view}<span class="arrow"><Icon name="arrow" /></span></a>
        <AddButton lang={lang} slug={tour.slug} />
      </div>
    </div>
  </article>
</li>

<style>
  .chapter { grid-column: 1 / -1; }
  article { position: relative; display: grid; gap: 1.5rem; }
  .figure { display: block; overflow: hidden; border-radius: var(--radius); aspect-ratio: 4 / 3; background: var(--deep); }
  .zoom { display: block; width: 100%; height: 112%; margin-top: -6%; will-change: transform; }
  .figure :global(picture), .figure :global(img) { display: block; width: 100%; height: 100%; }
  .figure :global(img) { object-fit: cover; transition: transform 1.4s var(--ease); }
  .figure:hover :global(img) { transform: scale(1.04); }
  .body { display: grid; gap: 0.9rem; align-content: center; }
  .meta { display: flex; align-items: baseline; gap: 1rem; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700; color: var(--ink-soft); }
  h3 { font-size: clamp(2.3rem, 8vw, 4.6rem); }
  h3 a { text-decoration: none; }
  .tagline { font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: clamp(1.15rem, 2.2vw, 1.5rem); color: var(--ink-soft); }
  .highlights { display: grid; gap: 0.1rem; margin-block: 0.4rem; }
  .highlights li { padding: 0.55rem 0; border-top: 1px solid rgb(10 30 38 / 0.12); font-size: 0.95rem; }
  .highlights li:last-child { border-bottom: 1px solid rgb(10 30 38 / 0.12); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.4rem; }
  .btn-solid { --btn-bg: var(--turq-500); --btn-fg: var(--ocean-950); }

  /* Cinema: imagen a sangre con el texto montado sobre ella */
  .is-cinema .figure { aspect-ratio: 4 / 5; }
  /* Noche: cierre oscuro a sangre completa */
  .is-night { margin-inline: calc(var(--gutter) * -1); }
  .is-night article { background: var(--deep); color: var(--white); padding: 0 0 2.5rem; gap: 0; }
  .is-night .figure { border-radius: 0; aspect-ratio: 4 / 5; }
  .is-night .figure::after { content: ''; position: absolute; inset: 40% 0 0; background: linear-gradient(transparent, var(--deep)); pointer-events: none; }
  .is-night .figure { position: relative; }
  .is-night .body { padding-inline: var(--gutter); margin-top: -5rem; position: relative; }
  .is-night .meta, .is-night .tagline { color: rgb(255 255 255 / 0.75); }
  .is-night .highlights li { border-color: rgb(255 255 255 / 0.18); }

  /* Póster tipográfico: capítulos sin fotografía todavía */
  .is-poster article { min-height: 30rem; height: 100%; padding: clamp(1.5rem, 4vw, 2.75rem); border-radius: var(--radius); overflow: hidden; color: var(--white); background: linear-gradient(155deg, var(--deep) 10%, color-mix(in srgb, var(--accent) 32%, var(--deep)) 100%); align-content: end; isolation: isolate; }
  .caustics { position: absolute; inset: -40%; z-index: -1; opacity: 0.5; background:
    radial-gradient(40% 30% at 30% 30%, color-mix(in srgb, var(--accent) 80%, white) 0, transparent 70%),
    radial-gradient(30% 40% at 70% 60%, color-mix(in srgb, var(--accent) 60%, transparent) 0, transparent 70%),
    radial-gradient(25% 25% at 55% 20%, rgb(255 255 255 / 0.35) 0, transparent 70%);
    filter: blur(30px); animation: caustic 18s ease-in-out infinite alternate; }
  @keyframes caustic { to { transform: translate(8%, -6%) rotate(14deg) scale(1.15); } }
  .is-poster .meta, .is-poster .tagline { color: var(--white); }
  .is-poster h3 { font-size: clamp(2.6rem, 9vw, 4.4rem); }
  .is-poster .highlights { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .is-poster .highlights li, .is-poster .highlights li:last-child { border: 1px solid rgb(255 255 255 / 0.35); border-radius: 999px; padding: 0.3rem 0.8rem; font-size: 0.82rem; background: rgb(255 255 255 / 0.08); }

  @media (min-width: 48rem) {
    .is-poster { grid-column: span 6; }
    .is-poster.is-tall article { min-height: 38rem; }
  }
  @media (min-width: 64rem) {
    article { grid-template-columns: repeat(12, 1fr); gap: 2rem; align-items: center; }
    .is-left .figure { grid-column: 1 / 8; aspect-ratio: 16 / 11; }
    .is-left .body { grid-column: 9 / 13; }
    .is-right .figure { grid-column: 6 / 13; grid-row: 1; aspect-ratio: 5 / 4; }
    .is-right .body { grid-column: 1 / 5; grid-row: 1; }
    .is-offset .figure { grid-column: 5 / 13; grid-row: 1; aspect-ratio: 16 / 10; }
    .is-offset .body { grid-column: 1 / 7; grid-row: 1; z-index: 1; background: var(--sand-50); padding: 2.5rem 2.5rem 2.5rem 0; border-radius: 0 var(--radius) var(--radius) 0; margin-top: 8rem; }
    .is-cinema article { display: block; }
    .is-cinema .figure { aspect-ratio: 21 / 10; }
    .is-cinema .body { position: relative; width: min(34rem, 46%); margin: -9rem 0 0 3rem; background: var(--sand-50); padding: 2.5rem; border-radius: var(--radius); box-shadow: 0 30px 60px -30px rgb(3 26 36 / 0.35); }
    .is-night { margin-inline: 0; }
    .is-night article { border-radius: var(--radius); overflow: hidden; padding: 0; gap: 0; align-items: stretch; }
    .is-night .figure { grid-column: 1 / 7; aspect-ratio: auto; min-height: 44rem; }
    .is-night .figure::after { inset: 0 0 0 55%; background: linear-gradient(90deg, transparent, var(--deep)); }
    .is-night .body { grid-column: 7 / 13; margin: 0; padding: 4rem 4rem 4rem 1rem; }
    .is-poster article { display: grid; grid-template-columns: 1fr; }
  }
</style>
