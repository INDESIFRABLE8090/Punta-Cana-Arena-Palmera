---
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import AddButton from '@/components/AddButton.astro';
import { languages, langMeta, homePath, tourPath, type Lang } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { site } from '@/config/site';
import { tours } from '@/data/tours';
import { waLink } from '@/scripts/whatsapp';
import { creditFor } from '@/data/credits';
import { legalUi } from '@/i18n/legal';

export const getStaticPaths = () =>
  languages.flatMap((lang) => tours.map((tour) => ({ params: { lang, section: langMeta[lang].tourSegment, slug: tour.slug } })));

const lang = Astro.params.lang as Lang;
const d = t(lang);
const index = tours.findIndex((x) => x.slug === Astro.params.slug);
const tour = tours[index]!;
const prev = tours[(index - 1 + tours.length) % tours.length]!;
const next = tours[(index + 1) % tours.length]!;
const name = tour.name[lang];
const abs = (p: string) => new URL(p, Astro.site).href;
const alternates = Object.fromEntries(languages.map((l) => [l, tourPath(l, tour.slug)])) as Record<Lang, string>;
const waMessage = d.client.waTour.replace('{tour}', name);
const num = String(index + 1).padStart(2, '0');
const credit = tour.image?.credit ? creditFor(tour.image.credit) : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name,
    description: tour.description[lang],
    url: abs(tourPath(lang, tour.slug)),
    inLanguage: langMeta[lang].htmlLang,
    touristType: d.categories[tour.category],
    provider: { '@type': 'TravelAgency', name: site.name, telephone: `+${site.whatsapp}`, url: abs(homePath(lang)) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: d.nav.home, item: abs(homePath(lang)) },
      { '@type': 'ListItem', position: 2, name: d.nav.experiences, item: abs(homePath(lang, '#experiencias')) },
      { '@type': 'ListItem', position: 3, name },
    ],
  },
];
---

<Base lang={lang} title={d.meta.tourTitle(name)} description={`${tour.tagline[lang]} ${tour.description[lang]}`.slice(0, 158)} alternates={alternates} jsonLd={jsonLd} overlayHeader waMessage={waMessage}>
  <article class="tour" style={`--accent:${tour.accent};--deep:${tour.deep}`}>
    <header class:list={['cover', { 'has-image': tour.image }]}>
      {tour.image ? (
        <div class="media">
          <Picture src={tour.image.src} alt={tour.image.alt[lang]} formats={['webp']} widths={[480, 768, 1080, 1600]} sizes="100vw" loading="eager" fetchpriority="high" quality={70} style={`object-position:${tour.image.position ?? '50% 50%'}`} />
        </div>
      ) : (
        <div class="caustics" aria-hidden="true"></div>
      )}
      <div class="shell cover-body">
        <nav aria-label={d.tour.breadcrumb}>
          <a class="back" href={homePath(lang, '#experiencias')}><span aria-hidden="true">←</span> {d.tour.back}</a>
        </nav>
        <p class="meta"><span>{num} / 11</span><span>{d.categories[tour.category]}</span></p>
        <h1 class="display">{name}</h1>
        <p class="tagline">{tour.tagline[lang]}</p>
      </div>
      <span class="ghost" aria-hidden="true">{num}</span>
    </header>

    <div class="shell layout">
      <div class="main">
        <p class="intro">{tour.description[lang]}</p>

        {tour.options ? (
          <section aria-labelledby="opt-title">
            <h2 class="display h-md" id="opt-title">{d.tour.optionsTitle}</h2>
            <div class="options">
              {tour.options.map((o) => (
                <div class="option">
                  <h3 class="display">{o.name[lang]}</h3>
                  <ul class="incl">{o.items[lang].map((x) => <li><Icon name="check" />{x}</li>)}</ul>
                </div>
              ))}
            </div>
          </section>
        ) : (
          <section aria-labelledby="inc-title">
            <h2 class="display h-md" id="inc-title">{d.tour.includesTitle}</h2>
            <ul class="incl">{tour.inclusions[lang].map((x) => <li><Icon name="check" />{x}</li>)}</ul>
          </section>
        )}

        {tour.notes[lang].length > 0 && (
          <section class="notes" aria-labelledby="note-title">
            <h2 id="note-title">{d.tour.notesTitle}</h2>
            <ul>{tour.notes[lang].map((x) => <li>{x}</li>)}</ul>
          </section>
        )}
        {tour.image && (
          <p class="illustrative">
            {d.tour.illustrative}
            {credit && <Fragment> {legalUi[lang].photo}: <a href={credit.source} target="_blank" rel="noopener noreferrer">{credit.author}</a>, <a href={credit.licenseUrl} target="_blank" rel="noopener noreferrer license">{credit.license}</a>.</Fragment>}
          </p>
        )}
      </div>

      <aside class="quote" aria-labelledby="q-title">
        <h2 class="display" id="q-title">{d.tour.quoteTitle}</h2>
        <p>{d.tour.quoteCopy}</p>
        <a class="btn btn-wa" href={waLink(waMessage)} target="_blank" rel="noopener noreferrer" data-wa><Icon name="whatsapp" size={20} />{d.experiences.ask}</a>
        <AddButton lang={lang} slug={tour.slug} />
        <a class="text-link" href={homePath(lang, '#itinerario')}>{d.nav.planner} <Icon name="arrow" /></a>
        <p class="fine">{d.experiences.priceNote}</p>
      </aside>
    </div>

    <nav class="shell pager" aria-label={d.nav.experiences}>
      <a href={tourPath(lang, prev.slug)} rel="prev"><small>← {d.tour.prev}</small><span class="display">{prev.name[lang]}</span></a>
      <a href={tourPath(lang, next.slug)} rel="next"><small>{d.tour.next} →</small><span class="display">{next.name[lang]}</span></a>
    </nav>
  </article>
</Base>

<style>
  .cover { position: relative; min-height: min(88svh, 52rem); display: grid; align-items: end; color: var(--white); overflow: clip; isolation: isolate; background: linear-gradient(155deg, var(--deep) 10%, color-mix(in srgb, var(--accent) 45%, var(--deep)) 100%); }
  .media { position: absolute; inset: 0; z-index: -2; }
  .media :global(picture), .media :global(img) { width: 100%; height: 100%; }
  .media :global(img) { object-fit: cover; animation: settle 2.4s var(--ease) both; }
  @keyframes settle { from { transform: scale(1.12); } }
  .has-image::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(3 26 36 / 0.55) 0%, rgb(3 26 36 / 0.05) 30%, rgb(3 26 36 / 0.82) 100%); }
  .caustics { position: absolute; inset: -40%; z-index: -1; opacity: 0.55; filter: blur(40px); background:
    radial-gradient(40% 30% at 30% 30%, color-mix(in srgb, var(--accent) 80%, white) 0, transparent 70%),
    radial-gradient(30% 40% at 70% 60%, color-mix(in srgb, var(--accent) 60%, transparent) 0, transparent 70%),
    radial-gradient(25% 25% at 55% 20%, rgb(255 255 255 / 0.35) 0, transparent 70%);
    animation: caustic 18s ease-in-out infinite alternate; }
  @keyframes caustic { to { transform: translate(8%, -6%) rotate(14deg) scale(1.15); } }
  .ghost { position: absolute; right: var(--gutter); top: calc(var(--header-h) + 1rem); font-family: var(--font-display); font-weight: 600; font-size: clamp(7rem, 26vw, 20rem); line-height: 0.8; color: transparent; -webkit-text-stroke: 1px rgb(255 255 255 / 0.35); z-index: -1; }
  .cover-body { padding-block: calc(var(--header-h) + 2rem) clamp(2rem, 6vw, 4.5rem); display: grid; gap: 1rem; }
  .back { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 3rem; text-decoration: none; font-size: 0.85rem; font-weight: 650; opacity: 0.9; }
  .back:hover { opacity: 1; text-decoration: underline; }
  .meta { display: flex; gap: 1.25rem; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700; color: color-mix(in srgb, var(--accent) 55%, white); }
  h1 { font-size: clamp(3rem, 12vw, 8rem); animation: up 1.2s var(--ease) both; }
  .tagline { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.3rem, 3vw, 2rem); animation: up 1.2s 0.15s var(--ease) both; }
  @keyframes up { from { opacity: 0; transform: translateY(2rem); } }

  .layout { display: grid; gap: 3rem; padding-block: clamp(3rem, 8vw, 6rem); }
  .main { display: grid; gap: clamp(2.5rem, 6vw, 4rem); }
  .intro { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.4rem, 3.2vw, 2.1rem); line-height: 1.3; letter-spacing: -0.01em; text-wrap: pretty; }
  .main h2.display { margin-bottom: 1.25rem; }
  .incl { display: grid; }
  .incl li { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; align-items: start; padding-block: 0.95rem; border-top: 1px solid rgb(10 30 38 / 0.12); font-size: 1.05rem; }
  .incl li:last-child { border-bottom: 1px solid rgb(10 30 38 / 0.12); }
  .incl :global(.icon) { margin-top: 0.3rem; color: color-mix(in srgb, var(--accent) 50%, var(--ink)); }
  .options { display: grid; gap: 1rem; }
  .option { padding: 1.5rem; border-radius: var(--radius); background: var(--deep); color: var(--white); }
  .option h3 { font-size: 2rem; color: var(--accent); margin-bottom: 0.5rem; }
  .option .incl li { border-color: rgb(255 255 255 / 0.18); }
  .option .incl :global(.icon) { color: var(--accent); }
  .notes { padding: 1.5rem; border-radius: var(--radius); background: var(--sand-100); border-left: 4px solid var(--accent); }
  .notes h2 { font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; margin-bottom: 0.5rem; }
  .notes li { font-weight: 600; }
  .illustrative { font-size: 0.8rem; color: var(--ink-soft); }

  .quote { display: grid; gap: 0.9rem; align-content: start; padding: clamp(1.5rem, 4vw, 2.25rem); border-radius: var(--radius); background: var(--white); box-shadow: 0 30px 70px -40px rgb(3 26 36 / 0.45); }
  .quote h2 { font-size: 2rem; }
  .quote p { color: var(--ink-soft); }
  .quote .btn { width: 100%; }
  .quote .text-link { justify-self: start; }
  .fine { font-size: 0.8rem; }

  .pager { display: grid; gap: 1px; padding-bottom: clamp(3rem, 8vw, 6rem); }
  .pager a { display: grid; gap: 0.4rem; padding: 1.5rem 0; border-top: 1px solid rgb(10 30 38 / 0.15); text-decoration: none; transition: color 0.3s; }
  .pager a:hover { color: var(--turq-700); }
  .pager small { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; color: var(--ink-soft); }
  .pager span { font-size: clamp(1.8rem, 5vw, 3rem); }
  .pager a[rel='next'] { text-align: right; }

  @media (min-width: 40rem) { .options { grid-template-columns: 1fr 1fr; } .pager { grid-template-columns: 1fr 1fr; gap: 2rem; } }
  @media (min-width: 62rem) {
    .layout { grid-template-columns: 1.5fr 1fr; gap: 5rem; align-items: start; }
    .quote { position: sticky; top: 6rem; }
  }
</style>
